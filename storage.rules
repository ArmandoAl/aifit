rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Nota:
    // - En desarrollo puedes abrir todo, pero en producción esto es una vulnerabilidad crítica.
    // - La convención del proyecto para Storage es: users/{uid}/...

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }

    // Deny by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
